# Copy to .env and adjust. Every setting is optional; defaults are shown.

# --- Service ---------------------------------------------------------------
LA_ENVIRONMENT=development
LA_LOG_LEVEL=INFO
LA_LOG_JSON=true
# When set, every /api/v1 route requires the header  X-API-Key: <value>
# LA_API_KEY=change-me
# LA_CORS_ORIGINS=["http://localhost:3000"]
LA_QUERY_TIMEOUT_S=600
LA_MAX_CONCURRENT_JOBS=2

# --- Data source -----------------------------------------------------------
# Path or glob, e.g. /data/*.parquet
LA_PARQUET_PATH=data/*.parquet
# Classic syslog timestamps ("Sep 27 00:00:06") carry no year. Leave unset to infer it
# (current year, with automatic rollover for December logs read in January).
# LA_LOG_YEAR=2026
LA_LOG_TIMEZONE=UTC
LA_CACHE_DATASET=true
LA_REDACT_SECRETS=true
LA_REDACT_EMAILS=true
# How "today" / "last 6 hours" are resolved: dataset_end (historical files) or now (live feeds)
LA_RELATIVE_TIME_ANCHOR=dataset_end

# --- LLM (Ollama) ----------------------------------------------------------
LA_LLM_ENABLED=true
LA_OLLAMA_BASE_URL=http://localhost:11434
# Any Ollama chat model: llama3.1:8b, qwen2.5:7b, mistral:7b, ...
LA_OLLAMA_MODEL=llama3.1:8b
LA_OLLAMA_EMBED_MODEL=nomic-embed-text
LA_OLLAMA_TIMEOUT_S=300
LA_OLLAMA_MAX_CONCURRENCY=2
LA_OLLAMA_NUM_CTX=8192

# --- RAG / PostgreSQL + pgvector -------------------------------------------
# LA_DATABASE_URL=postgresql://logan:logan@localhost:5432/logan
# Must match the embedding model (nomic-embed-text = 768, mxbai-embed-large = 1024)
LA_EMBEDDING_DIM=768
LA_EMBED_DOCUMENT_PREFIX="search_document: "
LA_EMBED_QUERY_PREFIX="search_query: "
LA_RAG_MAX_DOCUMENTS=5000

# --- Detection tuning ------------------------------------------------------
LA_ANOMALY_BUCKET=5m
LA_ANOMALY_Z_THRESHOLD=3.5
LA_SILENCE_GAP_MINUTES=15
